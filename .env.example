# Copy to .env and fill in. Get a token at https://screeps.com/a/#!/account/auth-tokens
SCREEPS_TOKEN=
# Seasonal server (default). Use https://screeps.com for the MMO world.
SCREEPS_API_URL=https://screeps.com/season
# Optional: code branch. Leave unset to upload to your active branch.
#SCREEPS_BRANCH=
# Optional: shard for observe reads. Leave unset on a single-shard server.
#SCREEPS_SHARD=
