{
  "why": "two of our bots side by side each keep their economy: neither loses a level, a spawn or its creeps",
  "modules": ["atlas", "economy", "exchange", "fight", "layout", "mv", "strategy", "tactics"],
  "start": { "room": "W8N3", "seed": 1, "opponents": [{ "name": "rival", "bot": "@bot", "room": "W7N3" }] },
  "ticks": 3000,
  "assert": [
    { "measure": "levelsLost", "max": 0 },
    { "measure": "levelsLost", "who": "rival", "max": 0 },
    { "measure": "spawnsLost", "max": 0 },
    { "measure": "spawnsLost", "who": "rival", "max": 0 },
    { "measure": "creepsAtEnd", "min": 5 },
    { "measure": "creepsAtEnd", "who": "rival", "min": 5 }
  ]
}
