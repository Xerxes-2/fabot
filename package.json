{
  "name": "fabot",
  "private": true,
  "scripts": {
    "build:fable": "rm -rf build && dotnet fable src/App -o build/fable",
    "build": "npm run build:fable --silent && rm -rf dist && node scripts/bundle.mjs",
    "format": "dotnet fantomas src tests",
    "format:check": "dotnet fantomas --check src tests",
    "upload": "node --env-file-if-exists=.env scripts/upload.mjs",
    "observe": "node --env-file-if-exists=.env scripts/observe.mjs",
    "profile": "node scripts/profile.mjs",
    "spar": "node scripts/spar.mjs",
    "cpuprofile": "node scripts/cpuprofile.mjs",
    "probe": "node scripts/probe.mjs",
    "wire": "npm run build:fable --silent && node scripts/wire-check.mjs",
    "adr-check": "bash scripts/adr-check.sh",
    "test": "npm run format:check --silent && npm run adr-check --silent && dotnet test && npm run wire --silent && node scripts/cli-smoke.mjs",
    "deploy": "npm run build && npm run upload",
    "capture-room": "node --env-file-if-exists=.env scripts/capture-room.mjs",
    "capture": "node --env-file-if-exists=.env scripts/capture-tick.mjs",
    "xx": "node scripts/xxscreeps/xx.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "screeps-api": "^2.1.0"
  }
}
