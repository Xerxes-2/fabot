{
  "name": "fabot",
  "private": true,
  "scripts": {
    "build": "node scripts/rust.mjs",
    "format": "cargo fmt --all",
    "format:check": "cargo fmt --all --check",
    "ceiling": "node scripts/ceiling.mjs",
    "test": "npm run format:check --silent && npm run ceiling --silent && cargo clippy --workspace --all-targets --features fabot/tools -- -D warnings && cargo clippy --workspace --exclude sim --target wasm32-unknown-unknown -- -D warnings && cargo test --workspace",
    "smoke": "node scripts/smoke.mjs",
    "upload": "node --env-file-if-exists=.env scripts/upload.mjs",
    "deploy": "npm run build --silent && npm run smoke --silent && npm run upload",
    "observe": "node --env-file-if-exists=.env scripts/observe.mjs",
    "cpuprofile": "node scripts/cpuprofile.mjs",
    "bench": "node --max-old-space-size=256 scripts/bench.mjs",
    "replay": "node scripts/replay.mjs",
    "xx": "node scripts/xxscreeps/xx.mjs",
    "soak": "node scripts/xxscreeps/soak.mjs",
    "soak:many": "node scripts/xxscreeps/soak-many.mjs",
    "soak:gen": "node scripts/sim/soak-gen.mjs",
    "soak:labs": "node scripts/sim/labs.mjs",
    "build:sim": "node scripts/sim/build.mjs",
    "watch:sim": "node scripts/sim/watch.mjs",
    "metrics:baseline": "node scripts/metrics-baseline.mjs",
    "scenario": "node scripts/xxscreeps/scenario.mjs",
    "exchange": "node scripts/sim/exchange.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "screeps-api": "^2.1.0"
  }
}
