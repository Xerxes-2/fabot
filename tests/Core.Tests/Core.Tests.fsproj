<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RoomFixtures.fs" />
    <Compile Include="IntentPlanTests.fs" />
    <Compile Include="ViewTests.fs" />
    <Compile Include="AtlasTests.fs" />
    <Compile Include="Decide/Fixtures.fs" />
    <Compile Include="Decide/LayoutTests.fs" />
    <Compile Include="Decide/PoolTests.fs" />
    <Compile Include="Decide/MatcherTests.fs" />
    <Compile Include="Decide/QuotaTests.fs" />
    <Compile Include="Decide/ColonyTests.fs" />
    <Compile Include="Decide/OutpostTests.fs" />
    <Compile Include="Decide/ThreatTests.fs" />
    <Compile Include="Decide/AnchorTests.fs" />
    <Compile Include="ObserveTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="RoomInvariantTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="rooms/*.room" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core/Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>
</Project>
